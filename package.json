    "astro-pagefind": "^2.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
