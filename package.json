{
  "name": "shaggy-singularity",
  "version": "1.2.1",
  "description": "A glassmorphism multi-purpose theme for Astro 7 - Blog, Portfolio & Landing Pages",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
